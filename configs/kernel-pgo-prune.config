# PGO base config fragment.  The shipping defaults from build.sh already
# disable IO_URING, EPOLL, TIMERFD, MFD_SYSCON, NEW_LEDS, WATCHDOG,
# DEVTMPFS, UNIX98_PTYS, PROC_SYSCTL, DEBUG_FS, PRINTK_TIME, KEYS, etc.
# This file is now reserved for PGO-cycle-only tweaks layered on top of
# the default build, leaving the validated subsystem disables in build.sh
# so non-PGO builds get them too.

CONFIG_CC_OPTIMIZE_FOR_SIZE=y

# Keep only the initramfs decompressor exercised by the QEMU PGO workload.
CONFIG_RD_GZIP=y
# CONFIG_RD_BZIP2 is not set
# CONFIG_RD_LZMA is not set
# CONFIG_RD_XZ is not set
# CONFIG_RD_LZO is not set
# CONFIG_RD_LZ4 is not set
# CONFIG_RD_ZSTD is not set
