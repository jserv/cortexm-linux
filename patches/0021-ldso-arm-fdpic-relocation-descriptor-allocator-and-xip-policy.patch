+static __always_inline void *
+_dl_funcdesc_for(void *entry_point, void *got_value);
+
+static __always_inline void
+arm_fdpic_write_funcdesc_value(struct funcdesc_value *dst,
+			       unsigned long entry_point, void *got_value)
+{
+	dst->entry_point = (void *)entry_point;
+	dst->got_value = got_value;
+}
+
+static __always_inline void
+arm_fdpic_relocate_funcdesc_value(struct funcdesc_value *dst,
+				  DL_LOADADDR_TYPE loadaddr)
+{
+	arm_fdpic_write_funcdesc_value(dst,
+		(unsigned long)DL_RELOC_ADDR(loadaddr, dst->entry_point),
+		loadaddr.got_value);
