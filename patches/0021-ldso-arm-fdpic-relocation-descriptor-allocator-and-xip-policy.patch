+
+static __always_inline unsigned long
+arm_fdpic_funcdesc(unsigned long symbol_addr, unsigned long addend,
+		   void *got_value)
+{
+	if (!symbol_addr)
+		return 0;
+
+	return (unsigned long)_dl_funcdesc_for((void *)(symbol_addr + addend),
+					       got_value);
