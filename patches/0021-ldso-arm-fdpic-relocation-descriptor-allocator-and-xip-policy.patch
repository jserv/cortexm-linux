+
+static __always_inline void
+arm_fdpic_resolve_funcdesc_value(struct funcdesc_value *dst,
+				 unsigned long symbol_addr,
+				 unsigned long addend,
+				 void *got_value)
+{
+	arm_fdpic_write_funcdesc_value(dst, symbol_addr + addend, got_value);
