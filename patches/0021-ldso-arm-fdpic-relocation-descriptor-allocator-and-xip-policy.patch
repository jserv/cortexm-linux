+					if (ELF_ST_BIND(symtab[symtab_index].st_info) == STB_LOCAL)
+						addend = *reloc_addr;
+					arm_fdpic_resolve_funcdesc_value(dst, symbol_addr, addend, got_value);
+				}
+				break;
+			case R_ARM_FUNCDESC:
+				*reloc_addr = arm_fdpic_funcdesc(symbol_addr, *reloc_addr,
+						def_mod ? def_mod->loadaddr.got_value : NULL);
+				break;
+#endif
+#if defined USE_TLS && USE_TLS
+			case R_ARM_TLS_DTPMOD32:
+				*reloc_addr = def_mod->l_tls_modid;
+				break;
+
+			case R_ARM_TLS_DTPOFF32:
+				*reloc_addr += symbol_addr;
+				break;
+
+			case R_ARM_TLS_TPOFF32:
+				CHECK_STATIC_TLS ((struct link_map *) def_mod);
+				*reloc_addr += (symbol_addr + def_mod->l_tls_offset);
+				break;
+#endif
+			default:
+				_dl_dprintf(2, "\n%s: ", _dl_progname);
+				if (symname)
+					_dl_dprintf(2, "symbol '%s': ", symname);
+				_dl_dprintf(2, "can't handle reloc type %x\n", reloc_type);
+				_dl_exit(1);
+		}
+#if defined (__SUPPORT_LD_DEBUG__)
+		if (_dl_debug_reloc && _dl_debug_detail && reloc_type != R_ARM_NONE)
+			_dl_dprintf(_dl_debug_file,
+				"\tpatch: %x ==> %x @ %x",
+				old_val, *reloc_addr, reloc_addr);
+#endif
+	}
+
+	return goof;
+}
