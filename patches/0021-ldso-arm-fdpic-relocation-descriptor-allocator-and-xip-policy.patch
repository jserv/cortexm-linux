+	for (i = 0; i < tpnt->n_phent; i++, phdr++) {
+		if (phdr->p_type != PT_LOAD)
+			continue;
+		if (seg_idx >= 8 * sizeof(ro_mask)) {
+			tpnt->rtld_flags |= DL_FDPIC_SEGMENT_MASK_OVERFLOW;
+			break;
+		}
+		if (!(phdr->p_flags & PF_W))
