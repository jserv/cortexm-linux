+static __always_inline void
+fdpic_init_segment_profile(struct elf_resolve *tpnt)
+{
+	ElfW(Phdr) *phdr = tpnt->ppnt;
+	unsigned long ro_mask = 0;
+	unsigned int seg_idx = 0;
+	int i;
